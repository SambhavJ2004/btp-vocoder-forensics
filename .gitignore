*.token
# The new-style Kaggle token is a bare file with no extension, so *.token
# does not cover it. It lives in ~/.kaggle, outside this tree; these lines
# exist so a stray copy inside the repo cannot be committed either.
access_token
**/access_token
**/.kaggle/

# ---------------------------------------------------------------------------
# Kaggle harness output: one directory per run, holding the code snapshot it
# uploaded, the kernel it pushed, the log and the downloaded output. Large,
# and reproducible from run.json plus the recorded snapshot hash.
# ---------------------------------------------------------------------------
runs/

# ---------------------------------------------------------------------------
# Data, checkpoints, generated audio — large and reproducible, keep out of git.
# Datasets are published as Kaggle Datasets; manifests (small) ARE committed.
#
# These are anchored with a leading slash on purpose: an unanchored "data/"
# also matches src/data/, which would silently exclude Person A's package.
# ---------------------------------------------------------------------------
# /data/* rather than /data/: git does not descend into a directory ignored as
# a whole, so a negation for anything inside it would silently do nothing.
# Ignoring the CONTENTS lets the one exception below take effect while every
# other path under data/ -- generated audio included -- stays excluded.
/data/*
# Measured evidence is committed: invariants cite it by row (INV-18), so it must
# be in history rather than on someone's Kaggle scratch disk.
!/data/measurements/
/datasets/
/corpora/
/checkpoints/
/ckpt/
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.tar.gz
*.zip
*.wav
*.flac
*.mp3
*.npy
*.npz
!tests/fixtures/**/*.wav

# Run outputs (anchored, same reason as above)
/runs/
/outputs/
/results/
/logs/
/lightning_logs/
/tensorboard/
*.log

